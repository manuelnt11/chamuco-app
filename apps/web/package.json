{
  "name": "@chamuco/web",
  "version": "0.1.0",
  "description": "Chamuco App - Next.js Frontend Application",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev --turbopack",
    "prebuild": "node scripts/generate-sw.mjs",
    "build": "next build",
    "start": "next start",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next dist coverage .turbo"
  },
  "dependencies": {
