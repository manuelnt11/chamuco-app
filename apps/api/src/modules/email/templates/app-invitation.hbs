<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap');
  </style>
</head>
<body style="margin:0;padding:0;background-color:#f0f9ff;font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif">
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f0f9ff;padding:40px 16px">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(15,76,117,.10)">

          {{! Header }}
          <tr>
            <td style="background:#0f4c75;padding:24px 32px">
              <table cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                  <td style="padding-right:12px;vertical-align:middle">
                    <img src="{{frontendUrl}}/logo-icon.svg" width="36" height="36" alt="" style="display:block" />
                  </td>
                  <td style="vertical-align:middle;line-height:1">
                    <span style="font-family:'Plus Jakarta Sans',-apple-system,sans-serif;font-size:18px;font-weight:800;color:#ffffff;letter-spacing:2px">CHAMUCO</span><span style="font-family:'Plus Jakarta Sans',-apple-system,sans-serif;font-size:18px;font-weight:600;color:#38bdf8;letter-spacing:2px"> TRAVEL</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {{! Body }}
          <tr>
            <td style="padding:40px 32px 32px;background:#ffffff">
              <p style="margin:0 0 4px;font-size:12px;font-weight:700;color:#38bdf8;text-transform:uppercase;letter-spacing:1px">Invitación</p>
              <h1 style="margin:0 0 12px;font-size:24px;font-weight:800;color:#0f4c75;line-height:1.2">{{inviterDisplayName}} te invita a unirse a Chamuco</h1>
              {{#if contextName}}
              <p style="margin:0 0 8px;font-size:15px;line-height:1.7;color:#4a7a9b">Te han invitado a <strong>{{contextName}}</strong>.</p>
              {{/if}}
              {{#if note}}
              <blockquote style="margin:0 0 20px;padding:12px 16px;background:#f0f9ff;border-left:3px solid #38bdf8;border-radius:0 8px 8px 0">
                <p style="margin:0;font-size:14px;font-style:italic;color:#4a7a9b">"{{note}}"</p>
              </blockquote>
              {{/if}}
              <p style="margin:0 0 24px;font-size:15px;line-height:1.7;color:#4a7a9b">Crea tu cuenta para ver la invitación y unirte.</p>
              <a href="{{ctaUrl}}" style="display:inline-block;padding:14px 32px;background:#38bdf8;color:#0f4c75;border-radius:999px;font-size:15px;font-weight:700;text-decoration:none;letter-spacing:.3px">Crear cuenta</a>
            </td>
          </tr>

          {{! Footer }}
          <tr>
            <td style="padding:20px 32px 28px;border-top:1px solid #bae6fd;background:#f0f9ff;text-align:center">
              <p style="margin:0;font-size:13px;color:#4a7a9b">
                Si no esperabas esta invitación, puedes ignorar este correo.
              </p>
              <p style="margin:8px 0 0;font-size:12px;color:#bae6fd">© {{currentYear}} Chamuco Travel. Todos los derechos reservados.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
