<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="utf-8" />
  <style>
    @page { margin: 32px 40px; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #0f4c75;
      font-size: 13px;
      line-height: 1.6;
    }
    header {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-bottom: 16px;
      border-bottom: 2px solid #0f4c75;
      margin-bottom: 20px;
    }
    header img {
      width: 72px;
      height: 72px;
      border-radius: 12px;
      object-fit: cover;
      flex-shrink: 0;
    }
    h1 { margin: 0 0 4px; font-size: 22px; font-weight: 800; }
    .trip-meta { color: #4a7a9b; font-size: 12px; }
    .route { color: #4a7a9b; font-size: 12px; margin-top: 4px; }
    h2 {
      font-size: 15px;
      font-weight: 700;
      color: #0f4c75;
      margin: 24px 0 8px;
      padding-bottom: 4px;
      border-bottom: 1px solid #bae6fd;
    }
    .destination {
      margin-bottom: 16px;
      page-break-inside: avoid;
    }
    .destination-title {
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .destination-label {
      color: #4a7a9b;
      font-weight: 400;
    }
    .empty {
      color: #94a3b8;
      font-style: italic;
    }
    .prose :first-child { margin-top: 0; }
    .prose :last-child { margin-bottom: 0; }
    footer {
      margin-top: 32px;
      padding-top: 12px;
      border-top: 1px solid #bae6fd;
      color: #94a3b8;
      font-size: 10px;
    }
  </style>
</head>
<body>
  <header>
    {{#if coverUrl}}<img src="{{coverUrl}}" alt="" />{{/if}}
    <div>
      <h1>{{tripName}}</h1>
      <div class="trip-meta">{{labels.dates}}: {{startDate}} — {{endDate}}</div>
      <div class="route">
        {{labels.departure}}: {{departureCity}}, {{departureCountry}}
        &nbsp;·&nbsp;
        {{labels.arrival}}: {{landingCity}}, {{landingCountry}}
      </div>
    </div>
  </header>

  {{#if generalNotesHtml}}
    <h2>{{labels.generalNotes}}</h2>
    <div class="prose">{{{generalNotesHtml}}}</div>
  {{/if}}

  <h2>{{labels.destinations}}</h2>
  {{#each destinations}}
    <div class="destination">
      <div class="destination-title">
        {{position}}. {{city}}, {{countryCode}}
        {{#if label}}<span class="destination-label">— {{label}}</span>{{/if}}
      </div>
      {{#if itineraryHtml}}
        <div class="prose">{{{itineraryHtml}}}</div>
      {{else}}
        <p class="empty">{{../labels.noItinerary}}</p>
      {{/if}}
    </div>
  {{/each}}

  <footer>{{labels.generatedOn}} {{generatedAt}} · Chamuco Travel</footer>
</body>
</html>
