{
  "name": "@chamuco/api",
  "version": "0.1.0",
  "description": "Chamuco App - NestJS Backend API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "echo '❌ Schema push is disabled. Use db:generate instead.' && exit 1",
    "db:seed-admin": "ts-node -r tsconfig-paths/register src/database/seeds/seed-admin.ts",
    "db:seed-dev": "ts-node -r tsconfig-paths/register src/database/seeds/seed-dev.ts"
  },
  "dependencies": {
    "@chamuco/shared-types": "workspace:*",
    "@chamuco/shared-utils": "workspace:*",
    "@google-cloud/storage": "^8.0.0",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@scalar/nestjs-api-reference": "^1.2.14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.2.0",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.1",
    "marked": "^18.0.11",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "chokidar": "5.0.0",
    "dotenv": "17.4.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "jest": "30.5.1",
    "prettier": "catalog:",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "catalog:"
  }
}
