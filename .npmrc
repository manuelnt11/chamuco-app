registry=https://registry.npmjs.org/
# Cap Node.js heap for pnpm subprocess so the Renovate process (also Node.js) has
# room to coexist on the 3 GB CI runner. Without this, pnpm auto-scales to ~2 GB,
# pushing the combined RSS over the kernel OOM limit during --lockfile-only --recursive.
node-options=--max-old-space-size=768
